{
  "name": "@juspay/yama",
  "version": "6.1.1",
  "description": "Prompts-driven pull-request review agent on NeuroLink: config-driven skills, MCP tools, memory and fallback chains",
  "keywords": [
    "pr",
    "pull-request",
    "code-review",
    "ai",
    "agent",
    "automation",
    "bitbucket",
    "github",
    "security",
    "quality"
  ],
  "homepage": "https://github.com/juspay/yama#readme",
  "bugs": {
    "url": "https://github.com/juspay/yama/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/juspay/yama.git"
  },
  "license": "MIT",
  "author": "Juspay Technologies <support@juspay.in> (https://juspay.io)",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "yama": "./src/index.mjs"
  },
  "files": [
    "src/index.mjs",
    "src/init.mjs",
    "src/learn.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "action.yml"
  ],
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1",
    "pnpm": ">=10.34.5"
  },
  "packageManager": "pnpm@10.34.9",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "scripts": {
    "check": "tsc",
    "type-check": "pnpm run check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx test/run.ts",
    "prepare": "husky",
    "prepack": "pnpm run test",
    "validate": "pnpm run validate:env && pnpm run validate:security",
    "validate:all": "pnpm run lint && pnpm run type-check && pnpm run validate",
    "validate:env": "node scripts/validate-env.cjs",
    "validate:security": "node scripts/validate-security.cjs",
    "validate:commit": "node scripts/commit-validation.cjs",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run validate && pnpm run check && pnpm run lint && pnpm run test",
    "quality:all": "pnpm run lint && pnpm run format:check && pnpm run test",
    "check:all": "pnpm run lint && pnpm run format:check && pnpm run validate && pnpm run validate:commit"
  },
  "dependencies": {
    "@juspay/hippocampus": "^0.2.1",
    "@juspay/neurolink": "13.8.21",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/npm": "^13.1.2",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@types/node": "^22.20.0",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^10.0.2",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.8.1",
    "semantic-release": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pnpm": {
    "onlyBuiltDependencies": [],
    "overrides": {
      "@semantic-release/npm": "^13.1.5",
      "@huggingface/transformers>sharp": "^0.35.5",
      "onnxruntime-node>adm-zip": "^0.6.1",
      "pptxgenjs>image-size": "^2.0.3",
      "gaxios>uuid": "^11.1.1",
      "exceljs>uuid": "^11.1.1",
      "@opentelemetry/api": "~1.9.0",
      "@opentelemetry/core": "^2.8.0"
    }
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
