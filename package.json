{
  "name": "@juspay/yama",
  "version": "6.0.0",
  "description": "Prompts-driven pull-request review agent on NeuroLink: config-driven skills, MCP tools, memory and fallback chains",
  "keywords": [
    "pr",
    "pull-request",
    "code-review",
    "ai",
    "agent",
    "automation",
    "bitbucket",
    "github",
    "security",
    "quality"
  ],
  "homepage": "https://github.com/juspay/yama#readme",
  "bugs": {
    "url": "https://github.com/juspay/yama/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/juspay/yama.git"
  },
  "license": "MIT",
  "author": "Juspay Technologies <support@juspay.in> (https://juspay.io)",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "yama": "./reviewer/index.mjs"
  },
  "files": [
    "reviewer/index.mjs",
    "reviewer/init.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "action.yml"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.15.1",
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "type-check": "pnpm run check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx test/run.ts",
    "cli": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts",
    "prepare": "husky",
    "prepack": "pnpm run build && pnpm run test",
    "validate": "pnpm run validate:env && pnpm run validate:security",
    "validate:all": "pnpm run lint && pnpm run type-check && pnpm run validate",
    "validate:env": "node scripts/validate-env.cjs",
    "validate:security": "node scripts/validate-security.cjs",
    "validate:build": "node scripts/build-validations.cjs",
    "validate:commit": "node scripts/commit-validation.cjs",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run validate && pnpm run check && pnpm run lint && pnpm run build && pnpm run test",
    "quality:all": "pnpm run lint && pnpm run format && pnpm run test",
    "quality:metrics": "node scripts/quality-metrics.cjs",
    "quality:report": "pnpm run quality:metrics && echo 'Quality metrics saved to quality-metrics.json'",
    "check:all": "pnpm run lint && pnpm run format:check && pnpm run validate && pnpm run validate:commit"
  },
  "dependencies": {
    "@juspay/neurolink": "^12.7.4",
    "@juspay/hippocampus": "^0.1.8",
    "dotenv": "^17.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "@semantic-release/npm": "^13.1.2",
    "@semantic-release/release-notes-generator": "^14.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.0",
    "@types/yargs": "^17.0.35",
    "conventional-changelog-conventionalcommits": "^8.0.0",
    "eslint": "^10.0.2",
    "globals": "^16.0.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.8.1",
    "semantic-release": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "js-yaml": "^4.3.1",
    "yargs": "^18.0.0",
    "zod": "4.3.6"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "@semantic-release/npm": "^13.1.5"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.4.1"
  }
}
