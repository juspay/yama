# Yama environment.
#
# Nothing here is read from a committed file in CI — these names exist so you
# know which secrets to set. Yama references credentials by env var NAME in
# MCP.json and config.json; values never appear in configuration.

# ── VCS ──────────────────────────────────────────────────────────────────────
# Used by the MCP server that reads the pull request and posts comments.
#
# Use a NON-reserved name. ${GITHUB_TOKEN} is not reliably forwarded inside a
# composite action, and the failure surfaces much later as an opaque remote 401.
YAMA_GITHUB_TOKEN=

# ── Model provider ───────────────────────────────────────────────────────────
LITELLM_API_KEY=
LITELLM_BASE_URL=

# ── Observability (optional) ─────────────────────────────────────────────────
# Traces every model call and tool execution through NeuroLink.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
