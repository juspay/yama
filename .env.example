# Yama Environment Variables
# Copy this file to .env and fill in your actual credentials

# ============================================================================
# Provider Selection (GitHub or Bitbucket)
# ============================================================================
# Auto-detected from: GITHUB_* env vars > CLI params > clone URL > default (Bitbucket)
# To use GitHub provider:
#   1. Set GITHUB_TOKEN, or
#   2. Use --owner and --repo CLI parameters, or
#   3. Set GITHUB_REPOSITORY env var (auto set in GitHub Actions)

# ============================================================================
# GitHub MCP Configuration (for GitHub provider)
# ============================================================================
# The hosted GitHub MCP server (https://api.githubcopilot.com/mcp/) authenticates
# with a GitHub Personal Access Token (PAT) — a real PAT, NOT the ephemeral
# Actions GITHUB_TOKEN. Create one with `repo` (or pull_requests) scope:
#   https://github.com/settings/personal-access-tokens
# Yama accepts any of these (first one set wins):
#   YAMA_GITHUB_TOKEN -> GITHUB_TOKEN -> GH_TOKEN -> GITHUB_PERSONAL_ACCESS_TOKEN -> GITHUB_ACCESS_TOKEN
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# YAMA_GITHUB_TOKEN=github_pat_...     # Yama-specific name (forwarded by the GitHub Action)
# GITHUB_ACCESS_TOKEN=github_pat_...   # dedicated PAT name (Curator/DNV parity)

# Optional: override the GitHub MCP endpoint (e.g. GitHub Enterprise / self-host)
# via .yama/config.yaml -> mcpServers.servers.github.url

# Automatically set by GitHub Actions, used for provider auto-detection
# GITHUB_REPOSITORY=owner/repo-name

# ============================================================================
# Bitbucket Configuration (Required for Bitbucket provider)
# ============================================================================
# Optional if using GitHub provider instead
BITBUCKET_USERNAME=your.email@company.com
BITBUCKET_TOKEN=your-http-access-token
BITBUCKET_BASE_URL=https://bitbucket.company.com

# ============================================================================
# AI Provider Configuration (Optional - defaults to auto-detection)
# ============================================================================
# Uncomment and set if you want to override the config file settings
# AI_PROVIDER=google-ai
# AI_MODEL=gemini-2.5-pro

# ============================================================================
# Google AI Configuration (if using google-ai provider)
# ============================================================================
# Get your API key from: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your-google-ai-api-key

# ============================================================================
# Alternative AI Providers (Optional)
# ============================================================================

# Anthropic Claude (if using anthropic provider)
# ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI (if using openai provider)
# OPENAI_API_KEY=your-openai-api-key

# AWS Bedrock (if using bedrock provider)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Azure OpenAI (if using azure provider)
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name

# ============================================================================
# Monitoring & Analytics (Optional)
# ============================================================================
# LOG_LEVEL=info
# ANALYTICS_ENABLED=true
# COST_TRACKING_ENABLED=true

# ============================================================================
# Langfuse Observability (Optional)
# ============================================================================
# Enable LLM tracing and observability with Langfuse
# Get your keys from: https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_ENABLED=true

# ============================================================================
# Performance Tuning (Optional)
# ============================================================================
# MAX_CONCURRENT_REVIEWS=3
# REVIEW_TIMEOUT=15m
# TOKEN_BUDGET_PER_REVIEW=500000

# ============================================================================
# Project-Level MCP Trust Gate (Optional)
# ============================================================================
# .yama/mcp.json can launch local processes and lives in the reviewed checkout,
# so Yama does NOT load it unless this is set from a trusted context (outside
# the checkout — a PR must not be able to enable it). Leave unset in CI that
# reviews untrusted PRs.
# YAMA_ENABLE_PROJECT_MCP=true

# ============================================================================
# Explorer Sub-Agent Overrides (Optional)
# ============================================================================
# Override AI settings for the explore_context research sub-agent
# AI_EXPLORE_ENABLED=true
# AI_EXPLORE_PROVIDER=google-ai
# AI_EXPLORE_MODEL=gemini-2.5-flash
# AI_EXPLORE_TEMPERATURE=0.3
# AI_EXPLORE_MAX_TOKENS=8192
# AI_EXPLORE_TIMEOUT=5m
# AI_EXPLORE_CACHE_RESULTS=true

# ============================================================================
# Per-Repo Review Memory (Optional)
# ============================================================================
# Env vars take precedence over the yaml config (memory.*)
# YAMA_MEMORY_ENABLED=true
# YAMA_MEMORY_STORAGE_PATH=.yama/memory
# YAMA_MEMORY_MAX_WORDS=200
# YAMA_MEMORY_AUTO_COMMIT=true
# YAMA_MEMORY_PROMPT=your custom condensation prompt
