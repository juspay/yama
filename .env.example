# Yama environment.
#
# Nothing here is read from a committed file in CI — these names exist so you
# know which secrets to set. Yama references credentials by env var NAME in
# .yama/mcp.yaml and .yama/yama.yaml; values never appear in configuration.

# ── VCS ──────────────────────────────────────────────────────────────────────
# Used by the MCP server that reads the pull request and posts comments, and by
# `yama learn` to push what it learned.
#
# Use a NON-reserved name. ${GITHUB_TOKEN} is not reliably forwarded inside a
# composite action, and the failure surfaces much later as an opaque remote 401.
YAMA_GITHUB_TOKEN=
# Commit author for learn commits. Only needed when learn.git.auth is "https".
YAMA_GIT_USER=github-actions[bot]

# ── Model provider ───────────────────────────────────────────────────────────
LITELLM_API_KEY=
LITELLM_BASE_URL=

# ── Observability (optional) ─────────────────────────────────────────────────
# Traces every model call, tool execution and stage outcome. Worth having: the
# architecture's own design decisions came from reading production traces.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# ── Per-run overrides (optional) ─────────────────────────────────────────────
# Narrow on purpose: only knobs a CI operator legitimately flips per run.
# Anything that changes review semantics — rules, ownership, guards — stays in
# the repository where it is reviewable.
# YAMA_CONCURRENCY=high        # high | medium | low
# YAMA_VERDICT=false           # review without an approve/block decision
# YAMA_CHECKS=false            # skip configured checks for one run
# YAMA_CONFIDENCE_THRESHOLD=80 # inline judge acceptance bar, 0-100
